generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
  WARDEN
  SECURITY
  ADMIN
}

enum OutpassStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveCategory {
  SAME_DAY
  SHORT_LEAVE
  LONG_LEAVE
}

enum GrievanceStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  // --- Profile & Workflow Details ---
  fullName     String?
  regNumber    String?   @unique
  roomNumber   String?
  course       String?
  parentPhone  String?   // This will store the father's WhatsApp number (e.g., 8095446482)

  // --- Mentor-Student Hierarchical Link ---
  mentorId     String?
  mentor       User?     @relation("MentorStudents", fields: [mentorId], references: [id])
  students     User[]    @relation("MentorStudents")

  outpasses    Outpass[]
}

model Outpass {
  id              String         @id @default(uuid())
  passNumber      String?        @unique @default(cuid()) // <-- Added '?' to make it optional
  studentId       String
  
  // Leave Configuration
  leaveCategory   LeaveCategory  @default(SHORT_LEAVE)
  destination     String
  reason          String
  
  // Strict Timings
  departureDate   DateTime
  departureTime   String?        // e.g., "10:00 AM"
  returnDate      DateTime
  returnTime      String?        // e.g., "05:00 PM"

  // --- Multi-Tier Chain of Command ---
  parentStatus    OutpassStatus  @default(PENDING)
  mentorStatus    OutpassStatus  @default(PENDING)
  wardenStatus    OutpassStatus  @default(PENDING)
  
  // Overall status (For easy filtering on dashboards)
  status          OutpassStatus  @default(PENDING) 

  // Feedback / Audit Trail
  parentComment   String?
  mentorComment   String?
  wardenComment   String?

  // --- Security Tracking ---
  actualExitTime  DateTime?
  actualReturnTime DateTime?

  createdAt       DateTime       @default(now())

  student         User           @relation(fields: [studentId], references: [id])
}